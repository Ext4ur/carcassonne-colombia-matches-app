# Supabase Configuration
# Obtén estos valores desde tu proyecto Supabase: Settings > API

# URL del proyecto Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co

# Publishable Key (pública, segura para usar en el cliente)
# Reemplaza a la antigua "anon key"
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Secret Key (privada, solo para servidor/Edge Functions, NO exponer en el cliente)
# Reemplaza a la antigua "service_role key"
# Esta key solo se usa en Edge Functions o scripts de migración
VITE_SUPABASE_SECRET_KEY=your-secret-key-here
