# Supabase Configuration
# Obtén estos valores desde tu proyecto Supabase: Settings > API

# URL del proyecto Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co

# Publishable Key (pública, segura para usar en el cliente)
# Reemplaza a la antigua "anon key"
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Usuario dedicado de Supabase Auth para sincronización (requerido tras migración RLS 029)
# Crear en Supabase Dashboard > Authentication > Users
VITE_SUPABASE_SYNC_EMAIL=sync@your-project.example
VITE_SUPABASE_SYNC_PASSWORD=your-sync-user-password

# Secret Key (privada, solo para servidor/Edge Functions, NUNCA exponer en el cliente)
# Reemplaza a la antigua "service_role key"
# NO usar prefijo VITE_ - esa key solo se usa en Edge Functions o scripts de migración
# SUPABASE_SECRET_KEY=your-secret-key-here
