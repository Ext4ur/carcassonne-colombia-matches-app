# Supabase Configuration
# Obtén estos valores desde tu proyecto Supabase: Settings > API

# URL del proyecto Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co

# Publishable Key (pública, segura para usar en el cliente)
# Reemplaza a la antigua "anon key"
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Usuario dedicado de Supabase Auth para sincronización (build admin con sync)
# Crear en Supabase Dashboard > Authentication > Users (email + password)
# NO necesario para dist:win:store (modo tienda kiosk local)
VITE_SUPABASE_SYNC_EMAIL=sync@your-project.example
VITE_SUPABASE_SYNC_PASSWORD=your-sync-user-password

# Secret Key (privada, solo para servidor/Edge Functions/scripts admin, NUNCA exponer en el cliente)
# Reemplaza a la antigua "service_role key"
# Usar en scripts como generate-store-codes.mjs y cleanup-supabase-data.js
VITE_SUPABASE_SECRET_KEY=your-secret-key-here

# Build instalador tiendas Devir (kiosk local: un torneo, export JSON+Excel al finalizar)
# VITE_DEVIR_STORE_MODE=true

# Build sede central Devir (app completa solo local: import/export, sin Supabase)
# VITE_DEVIR_HQ_MODE=true
