{
  "name": "carcassonne-tournament-manager",
  "type": "module",
  "version": "1.2.0",
  "description": "Aplicación de gestión de torneos presenciales de Carcassonne Colombia",
  "main": "dist/main/main.js",
  "scripts": {
    "prepare": "husky",
    "dev": "npm run build:electron && concurrently -k \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "node -e \"setTimeout(() => {}, 3000)\" && electron . --enable-logging",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "vite build",
    "build:electron": "tsc -p tsconfig.main.json && node scripts/fix-electron-build.js",
    "dist": "npm run build && npm run rebuild-sqlite && electron-builder",
    "dist:win": "npm run build && npm run rebuild-sqlite && electron-builder --win",
    "dist:mac": "npm run build && npm run rebuild-sqlite && electron-builder --mac",
    "dist:linux": "npm run build && npm run rebuild-sqlite && electron-builder --linux",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "postinstall": "electron-builder install-app-deps",
    "rebuild-sqlite": "electron-rebuild -f -w better-sqlite3",
    "db:fix": "electron scripts/fix-db.js"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "carcassonne",
    "tournament",
    "manager"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.15.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.0.8",
    "vitest": "^2.1.6",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.1",
    "@tanstack/react-table": "^8.10.7",
    "better-sqlite3": "^12.4.6",
    "chart.js": "^4.4.1",
    "csv-writer": "^1.6.0",
    "drizzle-kit": "^0.20.6",
    "drizzle-orm": "^0.29.1",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "zustand": "^4.4.7"
  }
}